#!/bin/zsh
# Launch gork with credentials kept in OpenCode's local credential store.
set -euo pipefail

auth_file="${OPENCODE_AUTH_FILE:-$HOME/.local/share/opencode/auth.json}"
binary="${GORK_BINARY:-$HOME/.local/share/gork/gork-bin}"
# Keep this fork's config and runtime state separate from the original Grok CLI.
export GROK_HOME="${GROK_HOME:-$HOME/.gork}"

if [[ ! -x "$binary" ]]; then
  print -u2 "gork: managed binary not found at $binary"
  exit 1
fi

# OpenCode credentials are an optional convenience source.  A missing or
# expired OpenCode login must not prevent models backed by their own variables
# (for example DEEPSEEK_API_KEY) from starting.
if [[ -r "$auth_file" ]] && command -v jq >/dev/null 2>&1; then
  openai_token="$(jq -er '.openai.access // empty' "$auth_file" 2>/dev/null || true)"
  openai_expires="$(jq -er '.openai.expires // 0' "$auth_file" 2>/dev/null || true)"
  openrouter_key="$(jq -er '.openrouter.key // empty' "$auth_file" 2>/dev/null || true)"

  # OpenCode stores OAuth expiry as Unix milliseconds. Only expose a token
  # while it is valid; OpenCode remains responsible for refreshing it.
  if [[ "$openai_expires" =~ '^[0-9]+$' ]] && (( openai_expires > 1000000000000 )); then
    now_ms=$(( $(date +%s) * 1000 ))
    if (( openai_expires <= now_ms )); then
      openai_token=""
    fi
  fi

  [[ -n "$openai_token" ]] && export GORK_OPENAI_OAUTH_ACCESS_TOKEN="$openai_token"
  [[ -n "$openrouter_key" ]] && export XAI_API_KEY="$openrouter_key"
fi

exec "$binary" "$@"
