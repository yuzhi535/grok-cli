#!/bin/zsh
# Launch gcode with multi-provider credentials.
# - OpenAI Codex / ChatGPT OAuth is handled in-process via
#   [auth_provider.openai-codex] (see scripts/gcode-openai-codex-auth).
# - Optional OpenCode/OpenRouter keys are still exported when present.
set -euo pipefail

auth_file="${OPENCODE_AUTH_FILE:-$HOME/.local/share/opencode/auth.json}"
binary="${GCODE_BINARY:-${GORK_BINARY:-$HOME/.local/bin/gcode}}"
# Keep this fork's config and runtime state separate from the original Grok CLI.
export GCODE_HOME="${GCODE_HOME:-${GROK_HOME:-$HOME/.gcode}}"
export GROK_HOME="${GROK_HOME:-$GCODE_HOME}"

if [[ ! -x "$binary" ]]; then
  # Fall back to a cargo-built binary in the repo when developing.
  if [[ -x "${0:A:h}/../target/release/gcode" ]]; then
    binary="${0:A:h}/../target/release/gcode"
  elif [[ -x "${0:A:h}/../target/debug/gcode" ]]; then
    binary="${0:A:h}/../target/debug/gcode"
  else
    print -u2 "gcode: binary not found at $binary"
    exit 1
  fi
fi

# Ensure the Codex OAuth helper is on disk for [auth_provider.openai-codex].
helper_src="${0:A:h}/gcode-openai-codex-auth"
helper_dst="$GCODE_HOME/bin/gcode-openai-codex-auth"
if [[ -r "$helper_src" ]]; then
  mkdir -p "$GCODE_HOME/bin"
  if [[ ! -x "$helper_dst" ]] || ! cmp -s "$helper_src" "$helper_dst" 2>/dev/null; then
    cp "$helper_src" "$helper_dst"
    chmod 755 "$helper_dst"
  fi
fi

# Optional convenience: surface OpenRouter / OpenCode keys for non-Codex models.
if [[ -r "$auth_file" ]] && command -v jq >/dev/null 2>&1; then
  openrouter_key="$(jq -er '.openrouter.key // empty' "$auth_file" 2>/dev/null || true)"
  [[ -n "$openrouter_key" ]] && export XAI_API_KEY="$openrouter_key"
fi

exec "$binary" "$@"
